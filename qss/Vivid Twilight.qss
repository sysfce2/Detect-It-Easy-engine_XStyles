/* Vivid Twilight - generated theme for the XStyles set.
   Palette: bg #1a1f25 / views #232a32 / text #eef1f4 / accent #f54469 / accent2 #e7f200 */

QWidget
{
    color: #eef1f4;
    background-color: #1a1f25;
}

QWidget:disabled
{
    color: #6c7680;
}

/* ---- Item views ---- */

QTableView, QTreeView, QListView, QTableWidget, QTreeWidget, QListWidget
{
    background-color: #232a32;
    alternate-background-color: #2d3640;
    border: 1px solid #3a4550;
    gridline-color: #3a4550;
    selection-background-color: #f54469;
    selection-color: #ffffff;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover
{
    background-color: #2d3640;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected
{
    background-color: #f54469;
    color: #ffffff;
}

QHeaderView::section
{
    background-color: #2d3640;
    color: #eef1f4;
    border: 1px solid #3a4550;
    padding: 3px 5px;
}

QHeaderView::section:hover
{
    background-color: #3a4550;
}

QTableCornerButton::section
{
    background-color: #2d3640;
    border: 1px solid #3a4550;
}

/* ---- Tooltips ---- */

QToolTip
{
    background-color: #232a32;
    color: #eef1f4;
    border: 1px solid #f54469;
    padding: 2px;
    border-radius: 3px;
}

/* ---- Menus ---- */

QMenuBar
{
    background-color: #1a1f25;
}

QMenuBar::item
{
    background: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected
{
    background: #2d3640;
    border: 1px solid #f54469;
    border-radius: 3px;
}

QMenu
{
    background-color: #232a32;
    border: 1px solid #3a4550;
}

QMenu::item
{
    padding: 4px 24px 4px 24px;
}

QMenu::item:selected
{
    background-color: #f54469;
    color: #ffffff;
}

QMenu::item:disabled
{
    color: #6c7680;
}

QMenu::separator
{
    height: 1px;
    background: #3a4550;
    margin: 4px 8px;
}

/* ---- Inputs ---- */

QLineEdit, QPlainTextEdit, QTextEdit
{
    background-color: #232a32;
    color: #eef1f4;
    border: 1px solid #3a4550;
    border-radius: 3px;
    padding: 1px 3px;
    selection-background-color: #f54469;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus
{
    border: 1px solid #f54469;
}

QLineEdit:read-only
{
    background-color: #1a1f25;
}

/* ---- Buttons ---- */

QPushButton, QToolButton
{
    color: #eef1f4;
    background-color: #232a32;
    border: 1px solid #3a4550;
    border-radius: 3px;
    padding: 4px 10px;
}

QToolButton
{
    padding: 3px;
}

QPushButton:hover, QToolButton:hover
{
    border: 1px solid #f54469;
}

QPushButton:pressed, QToolButton:pressed
{
    background-color: #f54469;
    color: #ffffff;
}

QPushButton:checked, QToolButton:checked
{
    background-color: #090d79;
    border: 1px solid #f54469;
}

QPushButton:disabled, QToolButton:disabled
{
    color: #6c7680;
    background-color: #1a1f25;
}

QPushButton:default
{
    border: 1px solid #f54469;
}

/* ---- Combo boxes ---- */

QComboBox
{
    background-color: #232a32;
    color: #eef1f4;
    border: 1px solid #3a4550;
    border-radius: 3px;
    padding: 2px 6px 2px 6px;
    selection-background-color: #f54469;
    selection-color: #ffffff;
}

QComboBox:hover
{
    border: 1px solid #f54469;
}

QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #3a4550;
}

QComboBox::down-arrow
{
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #eef1f4;
}

QComboBox QAbstractItemView
{
    background-color: #232a32;
    color: #eef1f4;
    border: 1px solid #3a4550;
    selection-background-color: #f54469;
    selection-color: #ffffff;
}

/* ---- Spin boxes ---- */

QAbstractSpinBox
{
    background-color: #232a32;
    color: #eef1f4;
    border: 1px solid #3a4550;
    border-radius: 3px;
    padding: 1px 3px;
    selection-background-color: #f54469;
    selection-color: #ffffff;
}

QAbstractSpinBox:focus
{
    border: 1px solid #f54469;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button
{
    background-color: #2d3640;
    border: 1px solid #3a4550;
    width: 16px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover
{
    background-color: #3a4550;
}

QAbstractSpinBox::up-arrow
{
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #eef1f4;
}

QAbstractSpinBox::down-arrow
{
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #eef1f4;
}

/* ---- Group boxes ---- */

QGroupBox
{
    border: 1px solid #3a4550;
    border-radius: 4px;
    margin-top: 2ex;
}

QGroupBox::title
{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
    color: #e7f200;
}

/* ---- Scroll bars ---- */

QScrollBar:horizontal
{
    background: #1a1f25;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal
{
    background: #3a4550;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover
{
    background: #f54469;
}

QScrollBar:vertical
{
    background: #1a1f25;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical
{
    background: #3a4550;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover
{
    background: #f54469;
}

QScrollBar::add-line, QScrollBar::sub-line
{
    width: 0px;
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page, QScrollBar::sub-page
{
    background: none;
}

/* ---- Progress bars ---- */

QProgressBar
{
    background-color: #232a32;
    border: 1px solid #3a4550;
    border-radius: 3px;
    text-align: center;
    color: #eef1f4;
}

QProgressBar::chunk
{
    background-color: #090d79;
    border-radius: 2px;
}

/* ---- Tabs ---- */

QTabWidget::pane
{
    border: 1px solid #3a4550;
    top: -1px;
}

QTabBar::tab
{
    color: #eef1f4;
    background-color: #1a1f25;
    border: 1px solid #3a4550;
    padding: 5px 12px;
}

QTabBar::tab:hover
{
    border-color: #f54469;
}

QTabBar::tab:selected
{
    background-color: #232a32;
    color: #e7f200;
    border-bottom: 2px solid #f54469;
}

QTabBar::tab:!selected
{
    margin-top: 2px;
}

/* ---- Check and radio buttons ---- */

QCheckBox, QRadioButton
{
    color: #eef1f4;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator
{
    width: 13px;
    height: 13px;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked
{
    border: 1px solid #3a4550;
    background-color: #232a32;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked
{
    border: 1px solid #f54469;
    background-color: #f54469;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover
{
    border: 1px solid #f54469;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled
{
    border: 1px solid #6c7680;
    background-color: #1a1f25;
}

QRadioButton::indicator
{
    border-radius: 7px;
}

QRadioButton::indicator:unchecked, QRadioButton::indicator:checked
{
    border-radius: 7px;
}

/* ---- Misc ---- */

QSplitter::handle
{
    background: #1a1f25;
}

QSplitter::handle:hover
{
    background: #f54469;
}

QStatusBar
{
    background: #1a1f25;
    color: #eef1f4;
}

QStatusBar::item
{
    border: none;
}
